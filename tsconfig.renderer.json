{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*.test.ts"]
}
