{
  "name": "yantra",
  "version": "1.0.0",
  "description": "Local Electron app for a canvas-based LLM workspace",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:electron": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --sourcemap --define:__VAULT_DIAGNOSTICS__=false && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --sourcemap --define:__VAULT_DIAGNOSTICS__=false",
    "start": "pnpm build:electron:dev && sh -c 'vite --host 127.0.0.1 & VITE_PID=$!; electron .; kill $VITE_PID'",
    "build": "pnpm build:electron && vite build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:vault-ui": "pnpm build && esbuild tools/vault-ui-smoke.ts --bundle --platform=node --format=cjs --outfile=dist-electron/vault-ui-smoke.cjs --external:electron && electron dist-electron/vault-ui-smoke.cjs",
    "lint": "oxlint",
    "build:electron:dev": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --sourcemap --define:__VAULT_DIAGNOSTICS__=true && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --sourcemap --define:__VAULT_DIAGNOSTICS__=true",
    "test:vault-refactor": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist-electron/refactor-preload.cjs --external:electron --define:__VAULT_DIAGNOSTICS__=true && esbuild tools/vault-refactor-smoke.ts --bundle --platform=node --format=cjs --outfile=dist-electron/vault-refactor-smoke.cjs --external:electron --external:vite --define:__VAULT_DIAGNOSTICS__=true && electron dist-electron/vault-refactor-smoke.cjs"
  },
  "keywords": [
    "electron",
    "llm",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "esbuild": "^0.28.2",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-highlight": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-list": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extensions": "^3.30.3",
    "@tiptap/html": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@xyflow/react": "^12.11.3",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
